{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "outlook-email": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "outlook_email_mcp"
      ],
      "env": {
        "OUTLOOK_EMAIL_ENABLE_DRAFTS": "false",
        "OUTLOOK_EMAIL_ENABLE_SEND": "false"
      }
    }
  }
}
